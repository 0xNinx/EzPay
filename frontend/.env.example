# EzPay Frontend Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://horizon-testnet.stellar.org

# Application
NEXT_PUBLIC_APP_NAME=EzPay
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_WALLET_CONNECT=true
NEXT_PUBLIC_ENABLE_QR_PAYMENTS=true
NEXT_PUBLIC_ENABLE_PAYMENT_LINKS=true

# Analytics (Optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ANALYTICS_ID=

# Environment
NODE_ENV=development
